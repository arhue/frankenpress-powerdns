# Used by CI: the second request for / must be answered from the cache (simplefs on disk)
{
	admin off
	order cache before rewrite
	cache {
		ttl 60s
		simplefs {
			configuration {
				path /tmp/cache
				directory_size 10MB
			}
		}
	}
}

:8080 {
	cache
	header Cache-Control "public, max-age=60"
	respond "hello from caddy" 200
}
